@page "/customers"
@using Frontend.Services
@using Shared
@inject ICustomerRepository CustomerRepo

<h3 class="mb-4">Ügyfelek listája</h3>

<div class="mb-3">
    <a href="/add-customer" class="btn btn-success">
        <i class="bi bi-person-plus"></i> Új ügyfél felvétele
    </a>
</div>

@if (customers == null)
{
    <div class="d-flex align-items-center">
        <strong>Betöltés...</strong>
        <div class="spinner-border ms-auto" role="status" aria-hidden="true"></div>
    </div>
}
else if (!customers.Any())
{
    <div class="alert alert-info">Nincs még rögzített ügyfél az adatbázisban.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px">ID</th>
                        <th>Név</th>
                        <th>E-mail cím</th>
                        <th>Rendszámok</th>
                        <th class="text-end">Műveletek</th> @* <--- 1. ÚJ FEJLÉC A GOMBOKNAK *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@customer.Id</span></td>
                            <td class="fw-bold">@customer.Name</td>
                            <td>@customer.Email</td>
                            <td>
                                @if (customer.Works != null && customer.Works.Any())
                                {
                                    @foreach (var work in customer.Works)
                                    {
                                        <span class="badge bg-info text-dark me-1 border border-info">@work.LicensePlate</span>
                                    }
                                }
                            </td>
                            <td class="text-end">
                                @* <--- 2. SZERKESZTÉS ÉS TÖRLÉS GOMBOK *@
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-warning" href="edit-customer/@customer.Id" title="Szerkesztés">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCustomer(customer.Id)" title="Törlés">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private IEnumerable<CustomerDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    // 3. Külön metódusba tettem a betöltést, hogy törlés után is meg lehessen hívni
    private async Task LoadCustomers()
    {
        customers = await CustomerRepo.GetAllAsync();
    }

    // 4. A törlés metódusa
    private async Task DeleteCustomer(int id)
    {
        // Ha a Te repository-dban máshogy hívják a törlést (pl. DeleteCustomerAsync), akkor azt írd ide!
        await CustomerRepo.DeleteAsync(id);
        
        // Frissítjük a listát, hogy a törölt ügyfél eltűnjön a képernyőről
        await LoadCustomers();
    }
}