@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using Frontend.Services
@using Shared
@inject IAuthService AuthService
@inject NavigationManager NavManager

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Bejelentkezés</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div class="mb-3">
                        <label>E-mail cím</label>
                        <input type="email" class="form-control" @bind="loginRequest.Email" />
                    </div>
                    <div class="mb-3">
                        <label>Jelszó</label>
                        <input type="password" class="form-control" @bind="loginRequest.Password" />
                    </div>
                    
                    <button class="btn btn-primary w-100" @onclick="HandleLogin">Belépés</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new LoginRequest();
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        var response = await AuthService.LoginAsync(loginRequest);

        if (response != null)
        {
            // Ha sikeres a belépés, átirányítjuk a főoldalra
            NavManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "Hibás e-mail cím vagy jelszó!";
        }
    }
}